# === Runtime IP stamp ===
.rovac_mac_ip

# === CycloneDDS configs are runtime-mutated (rendered from .template by ros2_env.sh) ===
# The .template files ARE tracked; the rendered files are gitignored because
# ros2_env.sh sed-mutates them on every Mac DHCP IP change.
config/cyclonedds_mac.xml
config/cyclonedds_pi.xml
config/cyclonedds_*.xml.tmp.*

# === Playwright MCP browser logs (ephemeral debug output) ===
.playwright-mcp/

# === RoArm-M2 vendor SDK (493MB, downloadable from Waveshare wiki on demand) ===
roarm/

# === rovac_v3 derived artifacts (regeneratable from .scad source) ===
# Keep .scad source, design docs, and audit_report.{json,md}.
# Drop renders, sliced gcode, exported stl, FEA mesh output.
rovac_v3/3D_model/renders/
rovac_v3/3D_model/audit_artifacts/*
!rovac_v3/3D_model/audit_artifacts/audit_report.*

# === External ROS2 packages (cloned via vcstool from external.repos) ===
# These are declared in ros2_ws/src/external.repos and pulled by
# `vcs import` during install. Do not commit them in this monorepo.
ros2_ws/src/rplidar_ros/
# Legacy unused fork — slated for removal:
ros2_ws/src/rplidar_ros2_driver/
ros2_ws/src/camera_ros/

# Photo source files (Photoshop) — too large for git
photos/**/*.psd
