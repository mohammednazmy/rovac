<?xml version="1.0"?>
<robot name="rovac_tank">

  <!-- ============================================================
       ROVAC tank URDF — frame conventions (REP-103)
         +X = FORWARD    +Y = LEFT    +Z = UP

       The robot drives forward toward base_link +X. The bare front
       (+X) carries only the red front_indicator; the LIDAR / camera
       / RPi / battery stack sits on the REAR deck (-X).

       Odometry: the ESP32 motor firmware applies the body-frame
       correction in serial_transport.c; `rovac_motor_driver` on the Pi
       is a clean raw passthrough (no odom params). The published /odom
       and odom->base_link TF are REP-103-correct (+X = forward = red
       box) — verified against the physical robot on 2026-05-18.

       Robot length/width, IMU X, rear-stack X, stereo-camera height,
       and sensor X/Y are measured (2026-05-18). Stack/sensor Z offsets
       (other than the camera) and box heights remain estimates.
       ============================================================ -->

  <!-- Base Link — robot chassis, origin at motor-shaft height (20mm from ground) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.2413 0.240 0.10"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
  </link>

  <!-- Front indicator — red marker at the robot's FRONT, base_link +X
       (the direction the robot drives forward, REP-103). -->
  <link name="front_indicator">
    <visual>
      <geometry>
        <box size="0.06 0.04 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="red_front">
        <color rgba="0.9 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <joint name="front_indicator_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_indicator"/>
    <origin xyz="0.13 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- Base Footprint (Projected on ground) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <!-- Motor shaft at 20mm from ground -->
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
  </joint>

  <!-- ==================== IMU ==================== -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- BNO055 on the ESP32 motor board, face-down. 180 deg rotation
         around X flips Z from down (board face) to up (ROS). Seated
         95.25mm forward of centre (+X), measured 2026-05-18. Z est. -->
    <origin xyz="0.09525 0 0.02" rpy="3.14159 0 0"/>
  </joint>

  <!-- ============================================================
       REAR DECK STACK  (chassis top deck, -X / REAR end)
       Physical stack, bottom to top:
         rpi_battery_link, rpi_link, laser_frame, stereo cameras
       All four share X and Y; Z climbs through the stack.
       Magnitudes below are best-estimates pending measurement.
       ============================================================ -->

  <!-- Raspberry Pi battery — bottom of the stack, on the chassis deck.
       Box size ESTIMATED — refine with measured battery dimensions. -->
  <link name="rpi_battery_link">
    <visual>
      <geometry>
        <box size="0.090 0.070 0.025"/>
      </geometry>
      <material name="battery_dark">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
  </link>

  <joint name="rpi_battery_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rpi_battery_link"/>
    <origin xyz="-0.0762 0 0.0625" rpy="0 0 0"/>
  </joint>

  <!-- Raspberry Pi 5 — on top of the battery. Board 85 x 56 mm;
       box height ESTIMATED (includes headers / components). -->
  <link name="rpi_link">
    <visual>
      <geometry>
        <box size="0.085 0.056 0.020"/>
      </geometry>
      <material name="rpi_green">
        <color rgba="0.0 0.45 0.2 1"/>
      </material>
    </visual>
  </link>

  <joint name="rpi_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rpi_link"/>
    <origin xyz="-0.0762 0 0.085" rpy="0 0 0"/>
  </joint>

  <!-- ==================== RPLIDAR C1 ==================== -->
  <!-- SLAMTEC RPLIDAR C1 DTOF, 55.6x55.6x41.3mm, scan plane 23.1mm from
       its base. Mounted on the REAR deck (-X), stacked above the RPi.
       laser_frame = scan plane. The RPLIDAR's 0deg azimuth points toward
       the lidar-stack end; since the 2026-05-18 front/rear redefinition
       that end is the robot REAR (-X), so laser_joint carries a 180deg
       yaw (rpy 0 0 pi) to align the scan with base_link (+X = front =
       red box). Verified 2026-05-18 with a rear-approach scan test:
       a person behind the robot must register behind the model. -->
  <link name="laser_frame">
    <visual>
      <geometry>
        <box size="0.0556 0.0556 0.0413"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="-0.0762 0 0.118" rpy="0 0 3.14159"/>
  </joint>

  <!-- ==================== Stereo Camera Rig (dual OV5647 NoIR on Pi 5 CSI) ====================
       Two Raspberry Pi NoIR Camera Module v1 (OV5647) sensors on Pi 5
       CAM0 (left) / CAM1 (right). Mounted directly ABOVE the RPLIDAR,
       on the REAR deck (-X).

       Frame tree:
         base_link
           +- stereo_camera_link           (rig centre, virtual)
              +- stereo_left_camera_link          (+Y from rig centre)
              |    +- stereo_left_camera_optical_frame   (X-right, Y-down, Z-fwd)
              +- stereo_right_camera_link         (-Y from rig centre)
                   +- stereo_right_camera_optical_frame  (X-right, Y-down, Z-fwd)

       Baseline (30mm each side) and rig height ESTIMATED, refine with
       mount measurements. Image messages reference the *_optical_frame. -->

  <link name="stereo_camera_link"/>

  <joint name="stereo_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="stereo_camera_link"/>
    <!-- Above the LIDAR on the rear deck (-X). Cameras measured at
         355.6mm above the floor (2026-05-18); base_link is 20mm above
         the floor, so Z = 0.3556 - 0.020 = 0.3356 m. -->
    <origin xyz="-0.0762 0 0.3356" rpy="0 0 0"/>
  </joint>

  <!-- LEFT camera body (Pi 5 CAM0). OV5647 module ~ 25x24x9 mm. -->
  <link name="stereo_left_camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.024 0.009"/>
      </geometry>
      <material name="camera_module_black">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
  </link>

  <joint name="stereo_left_camera_joint" type="fixed">
    <parent link="stereo_camera_link"/>
    <child link="stereo_left_camera_link"/>
    <!-- PLACEHOLDER baseline = 60mm; left camera at +30mm Y from rig centre. -->
    <origin xyz="0 0.030 0" rpy="0 0 0"/>
  </joint>

  <!-- LEFT optical frame (REP-103): X-right, Y-down, Z-forward.
       Rotation from camera_link to camera_optical_frame = RPY(-pi/2,0,-pi/2). -->
  <link name="stereo_left_camera_optical_frame"/>

  <joint name="stereo_left_camera_optical_joint" type="fixed">
    <parent link="stereo_left_camera_link"/>
    <child link="stereo_left_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- RIGHT camera body (Pi 5 CAM1). -->
  <link name="stereo_right_camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.024 0.009"/>
      </geometry>
      <material name="camera_module_black"/>
    </visual>
  </link>

  <joint name="stereo_right_camera_joint" type="fixed">
    <parent link="stereo_camera_link"/>
    <child link="stereo_right_camera_link"/>
    <!-- PLACEHOLDER: right camera at -30mm Y from rig centre (60mm baseline). -->
    <origin xyz="0 -0.030 0" rpy="0 0 0"/>
  </joint>

  <link name="stereo_right_camera_optical_frame"/>

  <joint name="stereo_right_camera_optical_joint" type="fixed">
    <parent link="stereo_right_camera_link"/>
    <child link="stereo_right_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- ============================================================
       SENSOR HUB FRAMES — 4x HC-SR04 ultrasonic + 2x Sharp IR cliff.
       Frame ids match rovac_sensor_driver: us_front_link, us_rear_link,
       us_left_link, us_right_link, cliff_front_link, cliff_rear_link.

       sensor_msgs/Range projects along each frame's +X axis, so the
       joint rpy aims the detection cone:
         us_front  +X -> +X  (forward)        rpy 0 0 0
         us_rear   +X -> -X  (rear)           rpy 0 0 pi
         us_left   +X -> +Y  (left)           rpy 0 0 +pi/2
         us_right  +X -> -Y  (right)          rpy 0 0 -pi/2
         cliff_*   +X -> -Z  (down at floor)  rpy 0 +pi/2 0

       X/Y measured 2026-05-18: front/rear sensors at the +-120.65mm
       edges (robot 241.3mm long); left/right at the +-70mm body edges
       (140mm-wide body; treads sit outboard). Z = measured height above
       floor minus 20mm (base_link sits 20mm up): us front/left/right
       0.0562, us rear 0.195, cliff front/rear 0.0308. (2026-05-18)
       ============================================================ -->

  <link name="us_front_link">
    <visual>
      <geometry><box size="0.020 0.045 0.015"/></geometry>
      <material name="us_cyan"><color rgba="0.1 0.7 0.9 1"/></material>
    </visual>
  </link>
  <joint name="us_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="us_front_link"/>
    <origin xyz="0.12065 0 0.0562" rpy="0 0 0"/>
  </joint>

  <link name="us_rear_link">
    <visual>
      <geometry><box size="0.020 0.045 0.015"/></geometry>
      <material name="us_cyan"/>
    </visual>
  </link>
  <joint name="us_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="us_rear_link"/>
    <origin xyz="-0.12065 0 0.195" rpy="0 0 3.14159"/>
  </joint>

  <link name="us_left_link">
    <visual>
      <geometry><box size="0.020 0.045 0.015"/></geometry>
      <material name="us_cyan"/>
    </visual>
  </link>
  <joint name="us_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="us_left_link"/>
    <origin xyz="0 0.070 0.0562" rpy="0 0 1.5707963"/>
  </joint>

  <link name="us_right_link">
    <visual>
      <geometry><box size="0.020 0.045 0.015"/></geometry>
      <material name="us_cyan"/>
    </visual>
  </link>
  <joint name="us_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="us_right_link"/>
    <origin xyz="0 -0.070 0.0562" rpy="0 0 -1.5707963"/>
  </joint>

  <link name="cliff_front_link">
    <visual>
      <geometry><box size="0.020 0.011 0.007"/></geometry>
      <material name="cliff_orange"><color rgba="0.95 0.55 0.1 1"/></material>
    </visual>
  </link>
  <joint name="cliff_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cliff_front_link"/>
    <origin xyz="0.12065 0 0.0308" rpy="0 1.5707963 0"/>
  </joint>

  <link name="cliff_rear_link">
    <visual>
      <geometry><box size="0.020 0.011 0.007"/></geometry>
      <material name="cliff_orange"/>
    </visual>
  </link>
  <joint name="cliff_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cliff_rear_link"/>
    <origin xyz="-0.12065 0 0.0308" rpy="0 1.5707963 0"/>
  </joint>

</robot>
