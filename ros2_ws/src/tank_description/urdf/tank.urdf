<?xml version="1.0"?>
<robot name="rovac_tank">

  <!-- Base Link - Center of robot chassis at motor shaft height (20mm from ground) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.22 0.245 0.10"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
  </link>

  <!-- Front indicator — red wedge showing forward direction (+X) -->
  <link name="front_indicator">
    <visual>
      <geometry>
        <box size="0.06 0.04 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="red_front">
        <color rgba="0.9 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <joint name="front_indicator_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_indicator"/>
    <!-- FRONT = LIDAR side = +X per docs/robot_dimensions.md -->
    <origin xyz="0.13 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- Base Footprint (Projected on ground) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <!-- Motor shaft at 20mm from ground -->
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Vacuum Suction Pad ==================== -->
  <!-- Dimensions per measurements (inch->mm):
       width  = 4.125" = 104.775 mm  (Y / lateral)
       depth  = 2.125" =  53.975 mm  (X / fore-aft)
       Rear edge sits 50.8 mm (2") in front of front edge of tracks.
       Front of tracks ~ base_link X = +0.110 m (chassis is 0.22 m long,
       base_link at center). So:
         pad rear edge  = +0.110 + 0.0508    = +0.1608 m  (base_link)
         pad center  X  = +0.1608 + 0.05398/2 = +0.1878 m
       Pad is dead-center laterally (Y=0). Parented to base_footprint so
       Z = 0 is the floor; pad center Z = half pad thickness ≈ 0.0025 m. -->
  <link name="vacuum_pad_link">
    <visual>
      <geometry>
        <box size="0.05398 0.10478 0.005"/>
      </geometry>
      <material name="vacuum_pad">
        <color rgba="0.15 0.15 0.15 0.85"/>
      </material>
    </visual>
  </link>

  <joint name="vacuum_pad_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="vacuum_pad_link"/>
    <origin xyz="0.1878 0 0.0025" rpy="0 0 0"/>
  </joint>

  <!-- ==================== RPLIDAR C1 ==================== -->
  <!-- SLAMTEC RPLIDAR C1 DTOF, 55.6x55.6x41.3mm, scan height 23.1mm from base -->
  <link name="laser_frame">
    <visual>
      <geometry>
        <box size="0.0556 0.0556 0.0413"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <!-- LIDAR scan plane 140mm from ground, 120mm above base_link -->
    <origin xyz="0.015 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- ==================== IMU ==================== -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- BNO055 mounted face-down on main board, upper edge toward front.
         180° rotation around X flips Z-axis from down (board face) to up (ROS). -->
    <origin xyz="0 0 0.02" rpy="3.14159 0 0"/>
  </joint>

  <!-- Phone IMU + Super Sensor links removed 2026-04-26 — retired hardware
       was producing labels in Foxglove that cluttered the 3D view. The
       BNO055 (imu_link above) replaced the phone IMU; the sensor hub
       (4×HC-SR04 + 2×IR cliff) replaced super_sensor. The actual sensor
       hub mount frames (us_front_link etc.) are publisher-side static TFs
       from rovac_sensor_driver, not URDF — see ros2_ws/src/rovac_sensor_driver. -->

  <!-- ==================== Stereo Camera Rig (dual OV5647 NoIR on Pi 5 CSI) ====================
       Two Raspberry Pi NoIR Camera Module v1 (OV5647) sensors connected via CSI
       ribbon to Pi 5 CAM0 (left) and CAM1 (right). Driven by camera_ros + libcamera.

       PLACEHOLDER GEOMETRY — positions, orientation, and baseline below are
       defaults that will be refined when the physical 3D-printed mount is
       fabricated (Phase 2). The frame tree topology and naming conventions are
       fixed; only the joint origins/baseline will change post-mount.

       Frame tree (REP-103 compliant):
         base_link
           └── stereo_camera_link            (rig center, virtual)
                 ├── stereo_left_camera_link            (sensor body, +Y from rig center)
                 │     └── stereo_left_camera_optical_frame   (X-right, Y-down, Z-fwd)
                 └── stereo_right_camera_link           (sensor body, -Y from rig center)
                       └── stereo_right_camera_optical_frame  (X-right, Y-down, Z-fwd)

       The image messages reference the *_optical_frame (per REP-103), and the
       _link frames are for visualization + body-frame TF lookups. -->

  <link name="stereo_camera_link"/>

  <joint name="stereo_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="stereo_camera_link"/>
    <!-- PLACEHOLDER: 100mm forward of chassis center, 100mm above base_link. -->
    <origin xyz="0.10 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- LEFT camera body (Pi 5 CAM0). OV5647 module dimensions ≈ 25×24×9 mm. -->
  <link name="stereo_left_camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.024 0.009"/>
      </geometry>
      <material name="camera_module_black">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
  </link>

  <joint name="stereo_left_camera_joint" type="fixed">
    <parent link="stereo_camera_link"/>
    <child link="stereo_left_camera_link"/>
    <!-- PLACEHOLDER baseline = 60mm; left camera at +30mm Y from rig center. -->
    <origin xyz="0 0.030 0" rpy="0 0 0"/>
  </joint>

  <!-- LEFT optical frame (REP-103): X-right, Y-down, Z-forward.
       Rotation from camera_link (X-fwd, Y-left, Z-up) to camera_optical_frame is
       RPY = (-π/2, 0, -π/2). All image message headers reference this frame. -->
  <link name="stereo_left_camera_optical_frame"/>

  <joint name="stereo_left_camera_optical_joint" type="fixed">
    <parent link="stereo_left_camera_link"/>
    <child link="stereo_left_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- RIGHT camera body (Pi 5 CAM1). -->
  <link name="stereo_right_camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.024 0.009"/>
      </geometry>
      <material name="camera_module_black"/>
    </visual>
  </link>

  <joint name="stereo_right_camera_joint" type="fixed">
    <parent link="stereo_camera_link"/>
    <child link="stereo_right_camera_link"/>
    <!-- PLACEHOLDER: right camera at -30mm Y from rig center (60mm total baseline). -->
    <origin xyz="0 -0.030 0" rpy="0 0 0"/>
  </joint>

  <link name="stereo_right_camera_optical_frame"/>

  <joint name="stereo_right_camera_optical_joint" type="fixed">
    <parent link="stereo_right_camera_link"/>
    <child link="stereo_right_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

</robot>
