<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rovac_stereo_camera</name>
  <version>1.0.0</version>
  <description>
    ROVAC stereo camera bringup — dual RPi NoIR (OV5647) cameras on Pi 5 CSI ports.
    Provides launch files, placeholder camera_info, and integration glue around
    camera_ros + image_pipeline + stereo_image_proc for an industry-standard
    ROS2 stereo vision pipeline.
  </description>
  <maintainer email="mohammed@rovac.robot">Mohammed Nazmy</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>camera_ros</exec_depend>
  <exec_depend>image_pipeline</exec_depend>
  <exec_depend>image_proc</exec_depend>
  <exec_depend>stereo_image_proc</exec_depend>
  <exec_depend>camera_info_manager</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
